{
  "name": "janet-birthday-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "workspaces": [
    "worker"
  ],
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "npm run check:site && npm run check:worker",
    "check:site": "astro check",
    "check:worker": "npm --workspace worker run check",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "worker:dev": "npm --workspace worker run dev",
    "worker:types": "npm --workspace worker run types",
    "worker:migrate:local": "npm --workspace worker run migrate:local",
    "worker:dry-run": "npm --workspace worker run deploy:dry-run"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.9",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "gsap": "^3.12.5",
    "lenis": "^1.1.17",
    "lucide-react": "^0.454.0",
    "motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "satori": "^0.28.0",
    "satori-html": "^0.3.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
