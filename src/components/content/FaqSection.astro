---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  entries: CollectionEntry<"faq">[];
}

const { entries } = Astro.props;
const renderedEntries = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
---

<section
  aria-labelledby="faq-heading"
  class="relative z-10 mx-auto w-full max-w-3xl px-4 py-16"
  id="faq"
>
  <div class="mb-8 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-accent">
      Helpful details
    </p>
    <h2 class="mt-2 text-3xl font-bold" id="faq-heading">
      Frequently asked questions
    </h2>
  </div>

  <div class="grid gap-4">
    {
      renderedEntries.map(({ entry, Content }) => (
        <details class="group rounded-xl border border-border bg-card/90 p-5 shadow-lg">
          <summary class="cursor-pointer list-none font-semibold marker:hidden">
            <span class="flex items-center justify-between gap-4">
              {entry.data.question}
              <span aria-hidden="true" class="text-accent group-open:rotate-45">
                +
              </span>
            </span>
          </summary>
          <div class="content-copy mt-4 border-t border-border pt-4">
            <Content />
          </div>
        </details>
      ))
    }
  </div>
</section>

