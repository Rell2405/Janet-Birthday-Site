---
import { Image } from "astro:assets";

import islandInBloom from "@/assets/events/island-in-bloom.webp";
import poolPartyAttire from "@/assets/events/pool-party-attire.webp";
import whiteLights from "@/assets/events/white-lights.webp";

interface Props {
  page: "birthday-weekend" | "what-to-wear";
}

const { page } = Astro.props;
const heading =
  page === "what-to-wear"
    ? "Your event style inspiration"
    : "The signature weekend events";

const artwork = [
  {
    src: poolPartyAttire,
    title: "Pool Party Attire",
    caption:
      "Shades of blue on Friday and animal prints on Saturday for two distinct poolside moments.",
    alt: "Pool party attire guide showing shades of blue and animal-print outfit inspiration for the June 18 and 19 events.",
  },
  {
    src: whiteLights,
    title: "White Lights",
    caption:
      "An all-white Friday night welcome with island elegance, live music, and beachfront views.",
    alt: "White Lights event board with all-white attire inspiration for women and men at a beachfront evening celebration.",
  },
  {
    src: islandInBloom,
    title: "Janet’s Island in Bloom",
    caption:
      "Tropical cocktail chic for Janet’s Saturday evening 60th birthday celebration.",
    alt: "Island in Bloom attire board with tropical floral cocktail looks for Janet’s 60th birthday celebration.",
  },
];
---

<section
  aria-labelledby="event-art-heading"
  class="bg-[#e7ded0] px-5 py-20 text-emerald-950 sm:px-8 sm:py-28 lg:px-12"
>
  <div class="mx-auto max-w-[1320px]">
    <div class="mb-12 grid gap-6 lg:grid-cols-[220px_1fr] lg:gap-20">
      <p class="luxury-kicker">Event details</p>
      <h2
        class="font-display text-[clamp(3rem,6vw,6rem)] leading-[0.9] tracking-[-0.04em]"
        id="event-art-heading"
      >
        {heading}
      </h2>
    </div>

    <div class="grid gap-12">
      {
        artwork.map((item, index) => (
          <figure class="grid gap-6 border-t border-emerald-950/25 pt-8 lg:grid-cols-[1fr_280px] lg:items-start">
            <Image
              alt={item.alt}
              class="h-auto w-full bg-stone-100"
              loading={index === 0 ? "eager" : "lazy"}
              quality={86}
              sizes="(min-width: 1024px) 70vw, 100vw"
              src={item.src}
              widths={[640, 960, 1280, 1536]}
            />
            <figcaption class="lg:pt-2">
              <p class="luxury-kicker text-amber-900">
                {(index + 1).toString().padStart(2, "0")}
              </p>
              <h3 class="mt-3 font-display text-3xl">{item.title}</h3>
              <p class="mt-4 leading-7 text-emerald-950/80">{item.caption}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
