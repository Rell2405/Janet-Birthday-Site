---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  entries: CollectionEntry<"travel">[];
}

const { entries } = Astro.props;
const renderedEntries = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
---

<section
  aria-labelledby="travel-heading"
  class="relative z-10 mx-auto w-full max-w-5xl px-4 py-16"
  id="travel"
>
  <div class="mb-8 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-accent">
      Plan your journey
    </p>
    <h2 class="mt-2 text-3xl font-bold" id="travel-heading">Travel notes</h2>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    {
      renderedEntries.map(({ entry, Content }) => (
        <article class="rounded-xl border border-border bg-card/90 p-6 shadow-xl">
          <h3 class="text-xl font-bold">{entry.data.title}</h3>
          {entry.data.summary ? (
            <p class="mt-2 text-muted-foreground">{entry.data.summary}</p>
          ) : null}
          <div class="content-copy mt-4">
            <Content />
          </div>
        </article>
      ))
    }
  </div>
</section>

