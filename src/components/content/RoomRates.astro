---
const rates = [
  ["Resort View — 1 King Bed", "$467", "$259", "$240", "$142"],
  ["Resort View — 2 Queen Beds", "$467", "$259", "$240", "$142"],
  ["Partial Ocean View — 1 King Bed", "$506", "$278", "$253", "$142"],
  ["Partial Ocean View — 2 Queen Beds", "$506", "$278", "$253", "$142"],
  ["Ocean View — 1 King Bed", "$534", "$293", "$272", "$152"],
  ["Ocean View — 2 Queen Beds", "$534", "$293", "$272", "$152"],
];
---

<section
  aria-labelledby="room-rates-heading"
  class="bg-[#e7ded0] px-5 py-20 text-emerald-950 sm:px-8 sm:py-28 lg:px-12"
>
  <div class="mx-auto max-w-[1100px]">
    <p class="luxury-kicker">Current group pricing</p>
    <h2
      class="mt-5 font-display text-[clamp(3rem,6vw,6rem)] leading-[0.9] tracking-[-0.04em]"
      id="room-rates-heading"
    >
      Room rates at a glance
    </h2>
    <p class="mt-6 max-w-2xl leading-7 text-emerald-950/80">
      Rates are per person, per night and remain subject to availability and the
      terms of the group room block.
    </p>

    <div
      aria-label="Horizontally scrollable room-rate table"
      class="mt-10 overflow-x-auto border border-emerald-950/20 bg-stone-50"
      role="region"
      tabindex="0"
    >
      <table class="w-full min-w-[780px] border-collapse text-left">
        <thead class="bg-emerald-950 text-stone-50">
          <tr>
            <th class="p-4 text-xs uppercase tracking-[0.12em]" scope="col">
              Room category
            </th>
            <th class="p-4 text-xs uppercase tracking-[0.12em]" scope="col">
              Single / solo
            </th>
            <th class="p-4 text-xs uppercase tracking-[0.12em]" scope="col">
              Double / 2 guests
            </th>
            <th class="p-4 text-xs uppercase tracking-[0.12em]" scope="col">
              Triple / 3 guests
            </th>
            <th class="p-4 text-xs uppercase tracking-[0.12em]" scope="col">
              Children 3–12
            </th>
          </tr>
        </thead>
        <tbody>
          {
            rates.map((rate) => (
              <tr class="border-t border-emerald-950/15">
                <th class="p-4 font-semibold" scope="row">{rate[0]}</th>
                {rate.slice(1).map((value) => <td class="p-4">{value}</td>)}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

