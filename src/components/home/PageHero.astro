---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  index: number;
  hideDescription?: boolean;
}

const {
  eyebrow,
  title,
  description,
  index,
  hideDescription = false,
} = Astro.props;
---

<section class="relative isolate overflow-hidden bg-[#123d35] px-5 py-24 text-stone-50 sm:px-8 sm:py-32 lg:px-12">
  <div aria-hidden="true" class="absolute -right-32 -top-32 h-96 w-96 rounded-full border border-amber-100/20"></div>
  <div aria-hidden="true" class="absolute -right-20 -top-20 h-64 w-64 rounded-full border border-amber-100/20"></div>
  <div class="relative mx-auto max-w-[1320px]">
    <div class="grid gap-12 lg:grid-cols-[1fr_180px] lg:items-end">
      <div>
        <p class="luxury-kicker text-amber-100">{eyebrow}</p>
        <h1 class="mt-6 max-w-5xl font-display text-[clamp(4rem,9vw,9rem)] leading-[0.82] tracking-[-0.05em]">
          {title}
        </h1>
        {
          hideDescription ? null : (
            <p class="mt-8 max-w-2xl text-lg leading-8 text-white/80">
              {description}
            </p>
          )
        }
      </div>
      <p class="border-l border-white/25 pl-5 font-display text-6xl italic text-amber-100">
        {index.toString().padStart(2, "0")}
      </p>
    </div>
  </div>
</section>
