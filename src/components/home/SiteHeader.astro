---
import { eventConfig } from "@/config/event";
import {
  pathWithBase,
  siteTabs,
  type TabId,
} from "@/config/navigation";

interface Props {
  activeTab: TabId;
}

const { activeTab } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeHref = pathWithBase("/", base);
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50 text-white">
  <div
    class="mx-auto flex max-w-[1480px] items-center justify-between gap-4 px-4 py-4 sm:px-8 lg:px-12"
  >
    <a
      aria-label={`${eventConfig.identity.siteName} home`}
      class="group pointer-events-auto flex items-center gap-3 rounded-full border border-white/15 bg-[#071f1b]/70 py-2 pl-2 pr-5 shadow-[0_12px_40px_rgba(4,30,26,0.22)] backdrop-blur-xl transition-colors hover:bg-[#071f1b]/85"
      data-header-home
      href={homeHref}
    >
      <span
        aria-hidden="true"
        class="grid h-9 w-9 place-items-center rounded-full border border-white/50 font-display text-lg italic transition-colors group-hover:bg-white group-hover:text-emerald-950"
      >
        J
      </span>
      <span class="text-xs font-semibold uppercase tracking-[0.3em]">
        Janet · Jamaica
      </span>
    </a>

    <div class="pointer-events-auto relative" data-site-menu>
      <button
        aria-controls="site-menu-panel"
        aria-expanded="false"
        class="flex cursor-pointer list-none items-center gap-3 rounded-full border border-white/15 bg-[#071f1b]/70 px-5 py-3 text-xs font-semibold uppercase tracking-[0.22em] shadow-[0_12px_40px_rgba(4,30,26,0.22)] backdrop-blur-xl transition-colors hover:bg-[#071f1b]/85"
        data-header-menu
        type="button"
      >
        Menu
        <span aria-hidden="true" class="grid grid-cols-2 gap-[3px]">
          <span class="h-[3px] w-[3px] rounded-full bg-current"></span>
          <span class="h-[3px] w-[3px] rounded-full bg-current"></span>
          <span class="h-[3px] w-[3px] rounded-full bg-current"></span>
          <span class="h-[3px] w-[3px] rounded-full bg-current"></span>
        </span>
      </button>
      <nav
        aria-label="Birthday website sections"
        class="absolute right-0 top-full grid min-w-64 gap-1 rounded-3xl border border-white/15 bg-[#071f1b]/85 p-2 text-white shadow-2xl backdrop-blur-xl"
        data-menu-panel
        hidden
        id="site-menu-panel"
      >
        {
          siteTabs.map((tab) => (
            <a
              aria-current={tab.id === activeTab ? "page" : undefined}
              class:list={[
                "rounded-full px-4 py-3 hover:bg-white/10",
                tab.id === activeTab && "bg-white/15 text-amber-100",
              ]}
              href={pathWithBase(tab.path, base)}
            >
              {tab.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<script>
  const menus = document.querySelectorAll<HTMLElement>("[data-site-menu]");

  for (const menu of menus) {
    const trigger = menu.querySelector<HTMLButtonElement>("[data-header-menu]");
    const panel = menu.querySelector<HTMLElement>("[data-menu-panel]");
    const supportsHover = window.matchMedia("(hover: hover)").matches;
    let pointerInside = false;
    const isOpen = () => trigger?.getAttribute("aria-expanded") === "true";
    const setOpen = (open: boolean) => {
      trigger?.setAttribute("aria-expanded", String(open));
      if (panel) panel.hidden = !open;
    };
    const close = () => {
      setOpen(false);
    };

    menu.addEventListener("pointerenter", (event) => {
      if (supportsHover && event.pointerType === "mouse") {
        pointerInside = true;
        setOpen(true);
      }
    });
    menu.addEventListener("pointerleave", (event) => {
      if (supportsHover && event.pointerType === "mouse") {
        pointerInside = false;
        close();
      }
    });
    trigger?.addEventListener("click", () => {
      setOpen(supportsHover && pointerInside ? true : !isOpen());
    });
    menu.addEventListener("focusout", () => {
      window.setTimeout(() => {
        if (!menu.contains(document.activeElement)) close();
      });
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        close();
        trigger?.focus();
      }
    });
    document.addEventListener("pointerdown", (event) => {
      if (!menu.contains(event.target as Node)) close();
    });
  }
</script>
