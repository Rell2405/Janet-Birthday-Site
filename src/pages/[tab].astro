---
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";

import EditorialContent from "@/components/content/EditorialContent.astro";
import EventArtwork from "@/components/content/EventArtwork.astro";
import RoomRates from "@/components/content/RoomRates.astro";
import PageHero from "@/components/home/PageHero.astro";
import SiteFooter from "@/components/home/SiteFooter.astro";
import SiteHeader from "@/components/home/SiteHeader.astro";
import type { TabId } from "@/config/navigation";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  const entries = await getCollection(
    "tabPages",
    ({ data }) => !data.draft && data.tab !== "welcome",
  );

  return entries.map((entry) => ({
    params: { tab: entry.data.tab },
    props: { entry },
  }));
}

const { entry } = Astro.props as {
  entry: CollectionEntry<"tabPages">;
};
const { Content } = await render(entry);
const tab = entry.data.tab as TabId;
const showArtwork =
  tab === "birthday-weekend" || tab === "what-to-wear";
---

<Layout
  title={`${entry.data.title} · Janet Turns 60`}
  description={entry.data.description}
>
  <SiteHeader activeTab={tab} />
  <main>
    <PageHero
      eyebrow={entry.data.eyebrow}
      title={entry.data.title}
      description={entry.data.description}
      index={entry.data.order / 10}
    />
    <EditorialContent>
      <Content />
    </EditorialContent>
    {
      showArtwork ? (
        <EventArtwork page={tab as "birthday-weekend" | "what-to-wear"} />
      ) : null
    }
    {tab === "book-your-stay" ? <RoomRates /> : null}
  </main>
  <SiteFooter />
</Layout>
