---
import "@/styles/globals.css";
import { eventConfig } from "@/config/event";
import { serializeThemeVariables, themeConfig } from "@/config/theme";

interface Props {
  title?: string;
  description?: string;
  socialImageAlt?: string;
  rsvpEnabled?: boolean;
}

const {
  title = eventConfig.identity.title,
  description = eventConfig.identity.description,
  socialImageAlt = eventConfig.identity.socialImageAlt,
  rsvpEnabled = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const basePath = base.replace(/\/$/, "");
const site = Astro.site ?? new URL("https://www.janetsislandbloom.com");
const ogImage = new URL(`${basePath}/og.png`, site).href;
const canonical = new URL(base, site).href;
const themeVariables = serializeThemeVariables(themeConfig);
const apiOrigin = rsvpEnabled
  ? new URL(import.meta.env.PUBLIC_API_BASE).origin
  : null;
const csp = [
  "default-src 'self'",
  "img-src 'self' data:",
  "style-src 'self' 'unsafe-inline'",
  "font-src 'self' data:",
  `script-src 'self' 'unsafe-inline'${rsvpEnabled ? " https://challenges.cloudflare.com" : ""}`,
  `connect-src 'self'${apiOrigin ? ` ${apiOrigin}` : ""}`,
  `frame-src 'self'${rsvpEnabled ? " https://challenges.cloudflare.com" : ""}`,
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  "upgrade-insecure-requests",
].join("; ");
---

<!doctype html>
<html
  lang="en"
  class={themeConfig.colorScheme}
  style={themeVariables}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Security hardening (static-site friendly) -->
    <meta
      http-equiv="Content-Security-Policy"
      content={csp}
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content={themeConfig.colorScheme} />
    <meta name="theme-color" content={themeConfig.themeColor} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / social share -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={eventConfig.identity.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

  </head>
  <body class="min-h-screen antialiased">
    <slot />
  </body>
</html>
