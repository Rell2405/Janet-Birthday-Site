{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "janet-birthday-rsvp-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_ORIGINS": "http://localhost:4321,http://127.0.0.1:4321",
    "TURNSTILE_EXPECTED_ACTION": "",
    "TURNSTILE_EXPECTED_HOSTNAME": "",
    "RSVP_MAX_PARTY_SIZE": "10"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "janet-birthday-rsvp-dev",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RSVP_RATE_LIMITER",
      "namespace_id": "240501",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "env": {
    "staging": {
      "name": "janet-birthday-rsvp-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "ALLOWED_ORIGINS": "https://staging.example.com",
        "TURNSTILE_EXPECTED_ACTION": "turnstile-spin-v1",
        "TURNSTILE_EXPECTED_HOSTNAME": "staging.example.com",
        "RSVP_MAX_PARTY_SIZE": "10"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "janet-birthday-rsvp-staging",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "RSVP_RATE_LIMITER",
          "namespace_id": "240502",
          "simple": {
            "limit": 20,
            "period": 60
          }
        }
      ]
    },
    "production": {
      "name": "janet-birthday-rsvp-production",
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_ORIGINS": "https://www.example.com",
        "TURNSTILE_EXPECTED_ACTION": "turnstile-spin-v1",
        "TURNSTILE_EXPECTED_HOSTNAME": "www.example.com",
        "RSVP_MAX_PARTY_SIZE": "10"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "janet-birthday-rsvp-production",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "RSVP_RATE_LIMITER",
          "namespace_id": "240503",
          "simple": {
            "limit": 20,
            "period": 60
          }
        }
      ]
    }
  }
}
